load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    ["nginx.conf"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "app",
    srcs = glob(["app/**"]),
    visibility = ["//visibility:public"],
)

sh_test(
    name = "syntax_test",
    srcs = ["//build:tests/docs_syntax_test.sh"],
    data = [
        ":app",
        "@nodejs_linux_amd64//:node_bin",
        "@nodejs_linux_amd64//:node_files",
        "@nodejs_linux_amd64//:npm_files",
    ],
    env = {"NODE_BIN": "$(rootpath @nodejs_linux_amd64//:node_bin)"},
)
