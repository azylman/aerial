load("@rules_shell//shell:sh_test.bzl", "sh_test")

filegroup(
    name = "migrations",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

sh_test(
    name = "atlas_validate_test",
    srcs = ["//build:tests/atlas_validate_test.sh"],
    data = [
        ":migrations",
        "//services/eri/pkg/db:schema.sql",
        "@atlas_linux_amd64//file",
    ],
    env = {"ATLAS_BIN": "$(rootpath @atlas_linux_amd64//file)"},
)
