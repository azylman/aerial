{
  "mcpServers": {
    "discord": {
      "serverUrl": "http://discord-mcp:4001/mcp"
    },
    "docker": {
      "serverUrl": "http://docker-mcp:4002/mcp"
    },
    "github-mcp-server": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    },
    "ha-mcp": {
      "serverUrl": "${HA_TOKEN}"
    }
  }
}
