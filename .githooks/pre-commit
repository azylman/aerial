#!/bin/sh
set -eu

# Prevent MSYS2 from mangling Docker volume path colons on Windows
export MSYS_NO_PATHCONV=1

# Fast-path pre-commit static verification (< 1s, BOM hygiene and syntax checks)
if command -v powershell.exe >/dev/null 2>&1 && [ -f "./scripts/verify.ps1" ]; then
    powershell.exe -ExecutionPolicy Bypass -File ./scripts/verify.ps1 -Staged
elif [ -f "./scripts/verify.sh" ]; then
    ./scripts/verify.sh --staged
elif [ -f "scripts/verify.sh" ]; then
    sh scripts/verify.sh --staged
fi
exit 0