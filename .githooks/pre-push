#!/bin/sh
set -eu

# Prevent MSYS2 from mangling Docker volume path colons on Windows
export MSYS_NO_PATHCONV=1

echo "⚡ [Aerial Pre-Push Hook] Running full pre-flight verification gate..."

# Comprehensive pre-push verification (full lint, unit tests, and syntax checks)
if [ -f "./scripts/verify.sh" ]; then
    ./scripts/verify.sh --full
elif [ -f "scripts/verify.sh" ]; then
    sh scripts/verify.sh --full
fi

echo "✅ [Aerial Pre-Push Hook] All checks passed. Safe to push to remote."
exit 0
