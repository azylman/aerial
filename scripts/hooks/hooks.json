{
  "share-guard": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|edit_file|write_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "hook-guard share",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "schedule-guard": {
    "PreToolUse": [
      {
        "matcher": "schedule|run_command|manage_task|manage_subagents|view_file|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "hook-guard schedule",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "batch-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|read_file|replace_file_content|write_to_file|edit_file|write_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "hook-guard batch",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "search-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "hook-guard search",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "commit-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "hook-guard commit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
