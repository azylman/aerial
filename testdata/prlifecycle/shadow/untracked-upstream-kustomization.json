{
  "description": "Untracked upstream PRs never start a rollout. Synapse's flux sync_success path resolves a commit of an upstream Flux source (GitRepository gateway-api, Kustomization gateway-api-crds) to an upstream PR (kubernetes-sigs/gateway-api#5433) about hourly. The legacy registry has no row for it: TransitionDeploying returns no target (no deploy_started) and RecordKustomizationRequests is a no-op, so legacy only patches the Kustomization once per request. PRObject had built a fresh state, moved it to deploying with no merge commit and indexed it as a rollout that could never complete (g3-shadow-soak-r5). A PR that never saw register, Hydrate, opened or merge is untracked: every rollout event drops before mutating, so no state persists, no index update is sent, and no fact, reconcile or intended effect is recorded, for either effects owner. The contrasting tracked case is a registered merged PR, which still records the requests, reconciles once per generation and is tracked as a rollout.",
  "pr": {
    "repo": "kubernetes-sigs/gateway-api",
    "pr_number": 5433
  },
  "kustomizations": [
    {
      "namespace": "flux-system",
      "name": "gateway-api-crds"
    }
  ],
  "legacy_effects": [
    {
      "kind": "flux_reconcile",
      "key": "kubernetes-sigs/gateway-api#5433@:flux_reconcile"
    }
  ],
  "owned_events": [
    {
      "name": "upstream sync success patches without tracking",
      "event": "sync_success"
    },
    {
      "name": "upstream kustomization success patches without tracking",
      "event": "deploy_success",
      "source_kind": "Kustomization",
      "job_name": "gateway-api-crds"
    }
  ],
  "cases": [
    {
      "name": "hourly legacy upstream requests leave no state",
      "stream": [
        {
          "object": "PRObject",
          "handler": "HandleKustomizationRequested",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "jobs": ["gateway-api-crds"],
            "kustomization_requests": {
              "gateway-api-crds": {"namespace": "flux-system", "requested_at": "2026-11-21T04:55:46Z"}
            }
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleKustomizationRequested",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "jobs": ["gateway-api-crds"],
            "kustomization_requests": {
              "gateway-api-crds": {"namespace": "flux-system", "requested_at": "2026-11-21T05:57:27Z"}
            }
          }
        }
      ],
      "want": {
        "persisted": false,
        "repo_indexed": false
      }
    },
    {
      "name": "restate-owned upstream request starts no rollout",
      "stream": [
        {
          "object": "PRObject",
          "handler": "HandleKustomizationRequested",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "branch": "main",
            "jobs": ["gateway-api-crds"],
            "kustomization_requests": {
              "gateway-api-crds": {"namespace": "flux-system", "requested_at": "2026-11-21T04:55:46Z"}
            },
            "facts": [
              {"event": "deploy_started", "repo": "kubernetes-sigs/gateway-api", "pr_number": 5433, "status": "deploying"}
            ]
          }
        }
      ],
      "want": {
        "persisted": false,
        "repo_indexed": false
      }
    },
    {
      "name": "every rollout handler drops an untracked pr",
      "stream": [
        {
          "object": "PRObject",
          "handler": "HandleDeployObserved",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "job_name": "gateway-api-crds",
            "facts": [
              {"event": "deploy_started", "repo": "kubernetes-sigs/gateway-api", "pr_number": 5433, "job_name": "gateway-api-crds", "status": "deploying"}
            ]
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleRolloutProgress",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "job_name": "gateway-api-crds",
            "deployed_jobs": ["gateway-api-crds"],
            "deployed_kustomizations": ["gateway-api-crds"]
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleDeploySuccess",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "job_name": "gateway-api-crds",
            "facts": [
              {"event": "deploy_success", "repo": "kubernetes-sigs/gateway-api", "pr_number": 5433, "job_name": "gateway-api-crds", "status": "deployed"}
            ]
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleDeployFailed",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "banner": "gateway-api-crds failed",
            "facts": [
              {"event": "deploy_failed", "repo": "kubernetes-sigs/gateway-api", "pr_number": 5433, "job_name": "gateway-api-crds", "status": "deploy_failed"}
            ]
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleDeployAttemptFailed",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "job_name": "gateway-api-crds"
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleReadinessRetry",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "merge_sha": "c0ffee5433"
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleDeploySuccessPublished",
          "event": {
            "repo": "kubernetes-sigs/gateway-api",
            "pr_number": 5433,
            "job_name": "gateway-api-crds"
          }
        }
      ],
      "want": {
        "persisted": false,
        "repo_indexed": false
      }
    },
    {
      "name": "tracked restate-owned request patches once per generation",
      "setup": [
        {
          "object": "PRObject",
          "handler": "Register",
          "event": {
            "repo": "azylman/aerial",
            "pr_number": 2302,
            "branch": "feat/prospera",
            "head_sha": "h2302",
            "target_id": "100000000000000001",
            "title": "Prospera fix",
            "agent": "alpha"
          }
        },
        {
          "object": "PRObject",
          "handler": "HandleMerged",
          "event": {
            "repo": "azylman/aerial",
            "pr_number": 2302,
            "head_sha": "h2302",
            "merge_sha": "m2302",
            "branch": "feat/prospera"
          }
        }
      ],
      "stream": [
        {
          "object": "PRObject",
          "handler": "HandleKustomizationRequested",
          "event": {
            "repo": "azylman/aerial",
            "pr_number": 2302,
            "jobs": ["aerial-core"],
            "kustomization_requests": {
              "aerial-core": {"namespace": "flux-system", "requested_at": "2026-11-21T04:55:46Z"}
            }
          }
        }
      ],
      "want": {
        "persisted": true,
        "status": "deploying",
        "effects": [
          {"kind": "flux_reconcile", "key": "azylman/aerial#2302@:flux_reconcile"}
        ],
        "rollouts": [
          {"repo": "azylman/aerial", "pr_number": 2302}
        ],
        "repo_indexed": true
      }
    }
  ]
}
