        "merge_sha": "m2302",
        "branch": "feat/prospera"
      }
    },
    {
      "object": "PRObject",
      "handler": "HandleKustomizationRequested",
      "event": {
        "repo": "azylman/aerial",
        "pr_number": 2302,
        "head_sha": "m2302",
        "branch": "main",
