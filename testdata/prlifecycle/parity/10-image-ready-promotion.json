        "head_sha": "c110",
        "branch": "main",
        "jobs": [
          "apps"
        ],
        "requests": {
          "apps": {
            "namespace": "flux-system",
            "requested_at": "2026-11-20T11:00:00Z"
          }
        }
      }
    }
  ],
  "restate": [
