load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/azylman/aerial
# gazelle:exclude vendor
# gazelle:exclude node_modules
# gazelle:exclude .git
# gazelle:map_kind go_test go_test //build:go_test.bzl

gazelle(name = "gazelle")

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "canonical_hooks",
    srcs = ["scripts/hooks/hooks.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime_scripts",
    srcs = glob(
        ["scripts/**"],
        exclude = ["scripts/code-health/**"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime_rules",
    srcs = glob(["rules/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime_agents",
    srcs = glob([".agents/**"]),
    visibility = ["//visibility:public"],
)

exports_files([
    "services/github-runner/roborev-wrapper.sh",
    "services/github-runner/roborev-config.toml",
    "services/github-runner/claude-settings.json",
    "services/github-runner/entrypoint.sh",
    "mcp/infisical-mcp/standby.js",
    "mcp/infisical-mcp/entrypoint.sh",
])
