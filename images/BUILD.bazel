# Bundles Console React Vite assets into static dist tarball.
# Note: uses npm ci locally within a temporary workspace with no-sandbox and network access
# as a bridge during the rules_oci migration; aspect rules_js / hermetic toolchains are planned
# for a future build tooling chunk. The tar output is normalized with fixed mtime and ownership.
genrule(
    name = "console_ui_dist",
    srcs = [
        "//services/console/ui:ui_srcs",
        "//web/theme",
    ],
    outs = ["console_ui_dist.tar"],
    cmd = """
        set -e
        WORK=$$(mktemp -d)
        trap 'rm -rf "$$WORK"' EXIT
        mkdir -p "$$WORK/src/services/console/ui" "$$WORK/src/web/theme"
        cp -rL services/console/ui/* "$$WORK/src/services/console/ui/"
        cp -rL web/theme/* "$$WORK/src/web/theme/"
        cd "$$WORK/src/services/console/ui"
        npm ci --no-audit --no-fund --silent
        npm run build --silent
        tar --sort=name --mtime='2020-01-01 00:00:00Z' --owner=0 --group=0 --numeric-owner --transform 's|^|app/static/|' -cf "$$OLDPWD/$@" -C dist .
    """,
    tags = [
        "no-sandbox",
        "requires-network",
    ],
)

pkg_tar(
    name = "console_theme_layer",
    srcs = ["//web/theme:aerial-tokens.css"],
    package_dir = "/app/static",
)

aerial_go_image(
    name = "console",
    bin_path = "/app/aerial-console",
    exposed_ports = ["8080/tcp"],
    extra_tars = [
        ":console_static_layer",
        ":console_ui_dist",
        ":console_theme_layer",
    ],
    workdir = "/app",
)

