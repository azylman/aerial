)

# 2 Static / Migration images
pkg_tar(
    name = "docs_nginx_conf_layer",
    srcs = ["//services/docs-service:nginx.conf"],
    package_dir = "/etc/nginx",
)

pkg_tar(
    name = "docs_app_layer",
    srcs = ["//services/docs-service:app"],
    package_dir = "/usr/share/nginx/html",
    strip_prefix = "services/docs-service/app",
)

pkg_tar(
    name = "docs_theme_layer",
    srcs = ["//web/theme"],
    package_dir = "/usr/share/nginx/html/assets",
)

oci_image(
    name = "docs",
    base = "@nginx_base",
    cmd = [
        "nginx",
        "-g",
        "daemon off;",
    ],
    exposed_ports = ["80/tcp"],
    tars = [
        ":docs_nginx_conf_layer",
        ":docs_app_layer",
        ":docs_theme_layer",
    ],
    workdir = "/usr/share/nginx/html",
)

oci_load(
    name = "load_docs",
    image = ":docs",
    repo_tags = ["ghcr.io/azylman/aerial-docs:local"],
)

oci_push(
    name = "push_docs",
    image = ":docs",
    repository = "ghcr.io/azylman/aerial-docs",
)

pkg_tar(
    name = "migrator_layer",
    srcs = ["//services/eri/pkg/db:migrations"],
    package_dir = "/migrations",
    strip_prefix = "services/eri/pkg/db/migrations",
)

oci_image(
    name = "migrator",
    base = "@atlas_base",
    entrypoint = ["/atlas"],
    tars = [":migrator_layer"],
    user = "0:0",
)

oci_load(
    name = "load_migrator",
    image = ":migrator",
    repo_tags = ["ghcr.io/azylman/aerial-migrator:local"],
)

oci_push(
    name = "push_migrator",
    image = ":migrator",
    repository = "ghcr.io/azylman/aerial-migrator",
)

