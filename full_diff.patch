+			idx := args["idx"]
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{
+				"jsonrpc": "2.0", "id": req["id"], "result": map[string]interface{}{
+					"content": []map[string]interface{}{{"type": "text", "text": fmt.Sprintf("result-%v", idx)}},
