+	}
+	invDisp.RegisterToolRoute("inv_tool", ServerConfig{Name: "invalid-url", ServerURL: "://invalid-url-path\x7f"})
+	if _, err := invDisp.Execute(ctx, "inv_tool", nil); err == nil {
+		t.Errorf("expected error from invalid URL in Execute")
