bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/restatedev/sdk-go",
)
use_repo(go_deps, "com_github_bwmarrin_discordgo", "com_github_google_jsonschema_go", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_itchyny_gojq", "com_github_jackc_pgx_v5", "com_github_modelcontextprotocol_go_sdk", "com_github_nats_io_nats_go", "com_github_nats_io_nats_server_v2", "com_github_pgvector_pgvector_go", "com_github_prometheus_client_golang", "com_github_prometheus_client_model", "com_github_restatedev_sdk_go", "com_github_restatedev_sdk_go_x_mocks", "com_github_robfig_cron_v3", "com_github_stretchr_testify", "in_gopkg_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_trace", "org_golang_x_sync", "org_uber_go_goleak")
