bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/restatedev/sdk-go",
)
use_repo(go_deps, "com_github_bwmarrin_discordgo", "com_github_google_jsonschema_go", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_itchyny_gojq", "com_github_jackc_pgx_v5", "com_github_modelcontextprotocol_go_sdk", "com_github_nats_io_nats_go", "com_github_nats_io_nats_server_v2", "com_github_pgvector_pgvector_go", "com_github_prometheus_client_golang", "com_github_prometheus_client_model", "com_github_restatedev_sdk_go", "com_github_restatedev_sdk_go_x_mocks", "com_github_robfig_cron_v3", "com_github_stretchr_testify", "in_gopkg_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_trace", "org_golang_x_sync", "org_uber_go_goleak")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab",
    image = "gcr.io/distroless/static-debian12",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "nginx_base",
    digest = "sha256:8c950211a641ec5b23f265450517001f6bcca533666120ebe36cb4cff3d00a55",
    image = "index.docker.io/library/nginx",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "atlas_base",
    digest = "sha256:3cd6883d5ec2703741f750fd5f9efed3a61f8e164b9dcea93ab7a7be429a1b5b",
    image = "index.docker.io/arigaio/atlas",
    platforms = ["linux/amd64"],
)
use_repo(
    oci,
    "atlas_base",
    "atlas_base_linux_amd64",
    "distroless_static",
    "distroless_static_linux_amd64",
    "nginx_base",
    "nginx_base_linux_amd64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "restate_server_linux_amd64",
    build_file_content = 'exports_files(["restate-server"], visibility = ["//visibility:public"])',
    sha256 = "57d4496453104ce3a02cdd5b520db14de9086cce20f1483795b6b9b3f65cde03",
    strip_prefix = "restate-server-x86_64-unknown-linux-musl",
    urls = ["https://github.com/restatedev/restate/releases/download/v1.8.1-hotfix.2/restate-server-x86_64-unknown-linux-musl.tar.xz"],
)

