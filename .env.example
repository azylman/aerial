# ==============================================================================
# Aerial Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL!
# ==============================================================================

# 1. Gemini AI Inference Authentication
# RECOMMENDED: Antigravity CLI uses Google OAuth subscription authentication by default.
# For harness tests, benchmarks, or direct Gemini API scripts, you can optionally provide:
# GEMINI_HARNESS_API_KEY=your_gemini_api_key_here

# 2. Antigravity CLI Model Configuration (optional override; e.g. "gemini-3.8-flash-high")
# AGY_MODEL=gemini-3.8-flash-high

# 3. Discord Bot Credentials (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 5. Optional MCP Server Credentials & Tokens
# GitHub Personal Access Token (for GitHub MCP tools)
GITHUB_PAT=your_github_personal_access_token_here
# Infisical Secret Management Settings & Credentials
INFISICAL_HOST_URL=https://app.infisical.com
INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_MASK_SECRET_VALUES=false

# 6. Host Port & Path Mappings (Optional overrides)
ERI_HOST_PORT=8088
DISCORD_MCP_HOST_PORT=4001
GITHUB_MCP_HOST_PORT=4003
INFISICAL_MCP_HOST_PORT=4007
SYNAPSE_HOST_PORT=4020
VICTORIAMETRICS_MCP_HOST_PORT=4044
HARO_HOST_PORT=4005
AGENTSVIEW_HOST_PORT=8089
# Host directories for repository mounts
AERIAL_HOST_PROJECT_DIR=/share/aerial
AERIAL_PROJECT_DIR=/share/aerial
AGENTSVIEW_PUBLIC_ORIGINS=http://localhost:8089,http://127.0.0.1:8089
AGENTSVIEW_PUBLIC_URL=http://localhost:8089

# 7. Timezone Configuration (defaults to America/Los_Angeles)
DEFAULT_TIMEZONE=America/Los_Angeles

# 8. Private Configuration Repository Synchronization (Optional)
# URL of your private configuration repository (e.g. https://github.com/your-username/your-aerial-config.git)
# Starter template available at: https://github.com/azylman/aerial-config-example
AERIAL_CONFIG_REPO_URL=
AERIAL_HOST_CONFIG_DIR=/share/aerial-config
AERIAL_CONFIG_DIR=/share/aerial-config

# 9. PostgreSQL & Vector Persistence Configuration
POSTGRES_DB=aerial
POSTGRES_USER=aerial
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST_PORT=127.0.0.1:5432
# Optional custom connection string override:
# DATABASE_URL=postgres://aerial:your_secure_postgres_password_here@postgres:5432/aerial?sslmode=disable

# 10. Observability & Log Search Configuration (OpenObserve)
OPENOBSERVE_HOST_PORT=5080
OPENOBSERVE_ROOT_USER_EMAIL=admin@aerial.local
OPENOBSERVE_ROOT_USER_PASSWORD=Aerial!Logs2026#

# 11. Optional Local System-1 Ambient Triage Configuration (pjev)
# Directs ambient channel relevance scoring and thread titling to local System-1 ambient triage (pjev).
# Under k3s cluster networking, triage requests resolve via http://pjev.aerial/v1/systemone.
