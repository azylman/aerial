# ==============================================================================
# Aerial Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL!
# ==============================================================================

# 1. Gemini AI Inference (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Antigravity CLI Model Configuration (e.g. "Gemini 3.6 Flash (Low)", "Gemini 3.7 Flash (Low)")
AGY_MODEL=Gemini 3.6 Flash (Low)

# 3. Execution timeout in minutes for agent prompts and multi-turn tool runs
TIMEOUT_MINUTES=15

# 4. Discord Bot Credentials (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 5. Optional MCP Server Credentials & Tokens
# GitHub Personal Access Token (for GitHub MCP tools)
GITHUB_PAT=your_github_personal_access_token_here

# 6. Host Port & Path Mappings (Optional overrides)
AERIAL_BRAIN_HOST_PORT=8088
DISCORD_MCP_HOST_PORT=4001
DOCKER_MCP_HOST_PORT=4002
AGENTSVIEW_HOST_PORT=8089
AERIAL_PROJECT_DIR=/mnt/data/supervisor/share/aerial
AGENTSVIEW_PUBLIC_ORIGINS=http://192.168.1.14:8089,http://192.168.1.14,https://aerial.zylman.com,http://aerial.zylman.com
AGENTSVIEW_PUBLIC_URL=https://aerial.zylman.com

# 7. Timezone Configuration (defaults to America/Los_Angeles)
DEFAULT_TIMEZONE=America/Los_Angeles

# 8. Private Configuration Repository Synchronization (Optional)
# URL of your private configuration repository (e.g. https://github.com/your-username/your-aerial-config.git)
# Starter template available at: https://github.com/azylman/aerial-config-example
AERIAL_CONFIG_REPO_URL=
AERIAL_CONFIG_DIR=/mnt/data/supervisor/share/aerial-config
