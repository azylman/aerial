load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "aerial-tokens.css",
        "aerial-theme.js",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "theme",
    srcs = [
        "aerial-theme.js",
        "aerial-tokens.css",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "theme_test",
    srcs = ["//build:tests/theme_test.sh"],
    data = glob([
        "*.css",
        "*.js",
    ]) + [
        "@nodejs_linux_amd64//:node_bin",
        "@nodejs_linux_amd64//:node_files",
        "@nodejs_linux_amd64//:npm_files",
    ],
    env = {"NODE_BIN": "$(rootpath @nodejs_linux_amd64//:node_bin)"},
)
